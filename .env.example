ANTHROPIC_API_KEY=your_anthropic_api_key
SANDBOX_SNAPSHOT_ID=your_snapshot_id

# Optional — point the agent at an Anthropic-compatible relay instead of the
# official API. Must include the /v1 path segment.
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Optional — model id, defaults to claude-sonnet-5.
# ANTHROPIC_MODEL=claude-sonnet-5

# How the computer/bash tools are declared to the model.
#   schema (default) — plain function tools with an explicit JSON schema.
#                      Required for relays that drop provider-defined tools.
#   native           — Anthropic's trained computer_20250124 / bash_20250124.
#                      Best accuracy; use against the official API.
# COMPUTER_TOOL_MODE=schema

# Auth handled by `vercel link && vercel env pull` (VERCEL_OIDC_TOKEN) or:
# VERCEL_TOKEN=your_vercel_token
# VERCEL_TEAM_ID=your_vercel_team_id
# VERCEL_PROJECT_ID=your_vercel_project_id
